<!--
 site.xml can define relevance clauses that are applied
 to all fixlet contents (fixlets/tasks/analyses/computergroups) in the site
 This aids efficiency because, if false, none of the individual fixlets will be evaluated
-->
<Site>
  <Relevance>
    <![CDATA[
      windows of operating system
    ]]>
  </Relevance>
</Site>
