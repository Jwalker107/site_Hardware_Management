<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Analysis>
		<Title>Hardware Information (Universal) - CPU</Title>
		<Description><![CDATA[Learn more about this analysis online: <A href="https://bigfix.me/cdb/analysis/2994710">https://bigfix.me/cdb/analysis/2994710</A><BR><BR>
<P>This analysis provides information regarding the client's CPU.</P>
<P>&nbsp;</P>
<P>Requires: Version 8.2 or higher of the BES Client</P>
<P>Latest version found here: <A href="http://bigfix.me/analysis/details/2994583"><FONT color=#000080>http://bigfix.me/analysis/details/2994583</FONT></A> </P>]]></Description>
		<Relevance><![CDATA[/* This analysis uses inspectors that require version 8.2 or higher of the BES Client to function */ (version of client >= "8.2")]]></Relevance>
		<Relevance>if exists property "in proxy agent context" then not in proxy agent context else true</Relevance>
		<MIMEField>
			<Name>bigfixme-added-time</Name>
			<Value>Wed, 03 Sep 2014 11:49:35 GMT</Value>
		</MIMEField>
		<MIMEField>
			<Name>bigfixme-modification-time</Name>
			<Value>Wed, 03 Sep 2014 11:49:35 GMT</Value>
		</MIMEField>
		<MIMEField>
			<Name>bigfixme-ID</Name>
			<Value>2994710</Value>
		</MIMEField>
		<MIMEField>
			<Name>x-bfsync-source-id</Name>
			<Value>7020</Value>
		</MIMEField>
		<MIMEField>
			<Name>bigfixme-keywords</Name>
			<Value></Value>
		</MIMEField>
		<MIMEField>
			<Name>x-bfsync-source-actionsite</Name>
			<Value>http://BES-Dev-Root:52311/cgi-bin/bfgather.exe/actionsite</Value>
		</MIMEField>
		<MIMEField>
			<Name>bigfixme-versions-ids</Name>
			<Value>2994583,2994630,2994635</Value>
		</MIMEField>
		<MIMEField>
			<Name>x-bfsync-source-modification-time</Name>
			<Value>Tue, 15 Nov 2022 16:21:28 +0000</Value>
		</MIMEField>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 02 Feb 2023 15:24:30 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<Property Name="Number of Cores of CPUs" ID="1" EvaluationPeriod="P1D">if (exists properties whose (it as string contains "cpupackage")) then ((core of it*count of it) of cpupackage) else ERROR "cpupackage property not available"</Property>
		<Property Name="Number of CPUs" ID="2" EvaluationPeriod="P1D">if (exists properties whose (it as string contains "cpupackage")) then (count of cpupackage) else ERROR "cpupackage property not available"</Property>
		<Property Name="Number of Cores per CPU" ID="3" EvaluationPeriod="P1D">if (exists properties whose (it as string contains "cpupackage")) then (core of cpupackage) else ERROR "cpupackage property not available"</Property>
		<Property Name="# of Threads per CPU" ID="4" EvaluationPeriod="P1D">if (exists properties whose (it as string contains "cpupackage")) then (thread of cpupackage) else ERROR "cpupackage property not available"</Property>
		<Property Name="CPU Simultaneous MultiThreading supported?" ID="5" EvaluationPeriod="P1D">if(mac of operating system) then ERROR "not supported" else (if (exists properties whose(it as string starts with "smt capable" AND it as string contains "cpupackage")) then (smt capable of cpupackage) else ERROR "cpupackage property not available")</Property>
		<Property Name="CPU Simultaneous MultiThreading enabled?" ID="6" EvaluationPeriod="P1D">if (exists properties whose (it as string contains "cpupackage")) then (smt enabled of cpupackage) else ERROR "cpupackage property not available"</Property>
		<Property Name="Size of RAM (MB)" ID="7" EvaluationPeriod="P1D"><![CDATA[if (exists properties whose(it as string starts with "ram")) then ((if (it > 128) then (((it/32)*32) + (if (it mod 32 > 16) then 32 else 0) ) else it ) of (size of ram / (1024*1024))) else ERROR "ram property not available"]]></Property>
		<Property Name="brand string of CPU" ID="8" EvaluationPeriod="P2D">unique values of brand strings of processors</Property>
		<Property Name="family name of CPU" ID="9" EvaluationPeriod="P2D">unique values of family names of processors</Property>
		<Property Name="Vendor Name of CPU" ID="10" EvaluationPeriod="P2D">unique values of vendor names of processors</Property>
		<Property Name="CPU Family#" ID="11" EvaluationPeriod="P2D">unique values of families of processors</Property>
		<Property Name="CPU Model#" ID="12" EvaluationPeriod="P2D">unique values of models of processors</Property>
		<Property Name="CPU Hertz" ID="13" EvaluationPeriod="P2D">unique values of speeds of processors</Property>
		<Property Name="CPU Stepping#" ID="14" EvaluationPeriod="P2D">unique values of steppings of processors</Property>
		<Property Name="CPU Brand ID#" ID="15" EvaluationPeriod="P2D">unique values of brand ids of processors</Property>
		<Property Name="CPU Type#" ID="16" EvaluationPeriod="P2D">unique values of types of processors</Property>
		<Property Name="CPU Extended Model#" ID="17" EvaluationPeriod="P2D">unique values of extended models of processors</Property>
		<Property Name="CPU feature mask" ID="18" EvaluationPeriod="P2D">unique values of feature masks of processors</Property>
		<Property Name="# of Threads Total" ID="19" EvaluationPeriod="P2D">if (exists properties whose (it as string contains "cpupackage")) then ((thread of it*count of it) of cpupackage) else ERROR "cpupackage property not available"</Property>
		<Property Name="architecture of OS" ID="20" EvaluationPeriod="P2D">architecture of operating system</Property>
		<Property Name="CPU extended feature mask" ID="21" EvaluationPeriod="P2D">unique values of extended feature masks of processors</Property>
		<Property Name="CPU DisplayModel#" ID="22" EvaluationPeriod="P2D">if (exists families whose(it = 6 OR it = 15) of processors) then (it as integer) of ((left shift 4 of (it as bit set) of unique value of extended models of processors) + ((it as bit set) of unique value of models of processors)) else (unique value of models of processors) /* http://www.intel.com/content/www/us/en/architecture-and-technology/64-ia-32-architectures-software-developer-vol-2a-manual.html DisplayModel */</Property>
		<Property Name="CPU Extended Family#" ID="23" EvaluationPeriod="P2D">unique values of extended families of processors</Property>
		<Property Name="CPU DisplayFamily#" ID="24" EvaluationPeriod="P2D">if (15 != unique value of families of processors) then (unique value of families of processors) else (it as integer) of ((left shift 4 of (it as bit set) of unique value of extended families of processors) + ((it as bit set) of unique value of families of processors)) /* http://www.intel.com/content/www/us/en/architecture-and-technology/64-ia-32-architectures-software-developer-vol-2a-manual.html DisplayFamily */</Property>
	</Analysis>
</BES>
