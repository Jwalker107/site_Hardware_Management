<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Fixlet>
		<Title>Collect Hardware Devices and Drivers to JSON - Windows</Title>
		<Description><![CDATA[<P>Runs PowerShell to collect every hardware device Windows has enumerated, the driver installed for each one (INF, provider, version, date, signed) and the kernel drivers loaded now (with the file version of each loaded image), and saves the result as JSON in the <B>PowerShellProbes</B> folder under the BES Client folder, where it persists between actions.</P>
<P>Files written to &lt;BES Client folder&gt;\PowerShellProbes:</P>
<UL>
<LI><B>HardwareDrivers.json</B>: the last successful collection. It is replaced only by a later successful run.</LI>
<LI><B>HardwareDrivers_error.txt</B>: written when the latest run failed (Status, TimeUtc, Stage and Message lines) and removed by the next successful run.</LI></UL>
<P>The analysis &quot;Hardware Devices and Drivers from PowerShell Probe - Windows&quot; reports the results every hour.</P>
<P>This Fixlet is relevant when there is no collection from the last day, or when the latest run failed. Deploy it as a policy action that reapplies whenever relevant, with a wait between reapplications (for example 1 hour) so a computer where the collection keeps failing does not retry on every evaluation cycle. A failed run leaves the Fixlet relevant, so the action reports Failed.</P>]]></Description>
		<Relevance>windows of operating system and (if exists property "in proxy agent context" then not in proxy agent context else true)</Relevance>
		<Relevance><![CDATA[exists file "WindowsPowerShell\v1.0\powershell.exe" of system folder]]></Relevance>
		<Relevance><![CDATA[not exists files "HardwareDrivers.json" whose (now - modification time of it < 1 * day) of folders "PowerShellProbes" of parent folders of regapps "besclient.exe" or exists files "HardwareDrivers_error.txt" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Relevance>
		<Category>Hardware Inventory</Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 18:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to collect the hardware devices and drivers to JSON.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// Collect the hardware devices, their drivers and the kernel drivers loaded now, as JSON.
// Read by the analysis "Hardware Devices and Drivers from PowerShell Probe - Windows".
parameter "probe_folder" = "{pathname of parent folder of regapp "besclient.exe"}\PowerShellProbes"
parameter "error_file" = "HardwareDrivers_error.txt"

if {not exists folder (parameter "probe_folder")}
	folder create "{parameter "probe_folder"}"
endif
// The error report from an earlier run is removed; this run writes a new one if it fails
delete "{parameter "probe_folder"}\{parameter "error_file"}"

// The probe script; every left curly brace in it is doubled, BigFix's escape for relevance substitution
delete __createfile
createfile until _END_OF_SCRIPT_
<#
.SYNOPSIS
    Writes the hardware devices on this computer, their drivers and the kernel
    drivers loaded now to HardwareDrivers.json in OutputFolder.

.DESCRIPTION
    Run by the BigFix Fixlet "Collect Hardware Devices and Drivers to JSON - Windows";
    read by the analysis "Hardware Devices and Drivers from PowerShell Probe - Windows".

    The JSON is written under a temp name and then moved into place, so the
    analysis never reads a partial file. String fields are "" (never null) when
    Windows has no value, so the analysis relevance can cast every field as string.

    On failure it writes HardwareDrivers_error.txt (Status, TimeUtc, Stage,
    Message lines), keeps the last good JSON and exits 1. A successful run
    removes the error file and exits 0.
#>
param(
    [Parameter(Mandatory = $true)][string]$OutputFolder
)

$ErrorActionPreference = 'Stop'
# Path.Combine, not Join-Path: Join-Path throws outside the try block when the drive is missing
$jsonPath = [System.IO.Path]::Combine($OutputFolder, 'HardwareDrivers.json')
$errorPath = [System.IO.Path]::Combine($OutputFolder, 'HardwareDrivers_error.txt')
$tmpPath = "$jsonPath.tmp"
# Windows PowerShell 5.1 "-Encoding utf8" writes a BOM; write UTF-8 without one
$utf8NoBom = New-Object -TypeName System.Text.UTF8Encoding -ArgumentList $false
$stage = 'start'

function Get-UtcStamp
{{
    (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
}

# Kernel driver image paths come as \SystemRoot\..., System32\... or \??\C:\...
function Resolve-DriverPath([string]$Path)
{{
    if (-not $Path) {{ return '' }
    $p = $Path.Trim('"')
    if ($p.StartsWith('\??\')) {{ $p = $p.Substring(4) }
    if ($p -match '^\\SystemRoot\\') {{ $p = Join-Path -Path $env:SystemRoot -ChildPath $p.Substring(12) }
    elseif ($p -match '^System32\\') {{ $p = Join-Path -Path $env:SystemRoot -ChildPath $p }
    return $p
}

try
{{
    $stage = 'create output folder'
    if (-not (Test-Path -LiteralPath $OutputFolder)) {{ New-Item -ItemType Directory -Force -Path $OutputFolder | Out-Null }

    $stage = 'query Win32_PnPSignedDriver'
    $drivers = @{{}
    foreach ($d in Get-CimInstance -ClassName Win32_PnPSignedDriver)
    {{
        if ($d.DeviceID) {{ $drivers[$d.DeviceID] = $d }
    }

    # Every device Windows has enumerated, with its driver when one is installed
    $stage = 'query Win32_PnPEntity'
    $devices = @(foreach ($e in Get-CimInstance -ClassName Win32_PnPEntity)
    {{
        $d = $null
        if ($e.PNPDeviceID) {{ $d = $drivers[$e.PNPDeviceID] }
        $driverDate = ''
        if ($d -and $d.DriverDate) {{ $driverDate = ([datetime]$d.DriverDate).ToString('yyyy-MM-dd') }
        [pscustomobject]@{{
            Name           = [string]$e.Name
            Class          = [string]$e.PNPClass
            Manufacturer   = [string]$e.Manufacturer
            DeviceID       = [string]$e.PNPDeviceID
            Status         = [string]$e.Status
            ProblemCode    = [int]$e.ConfigManagerErrorCode
            DriverInf      = [string]$d.InfName
            DriverProvider = [string]$d.DriverProviderName
            DriverVersion  = [string]$d.DriverVersion
            DriverDate     = $driverDate
            DriverSigned   = [string]$d.IsSigned
        }
    })

    # Kernel drivers running now, with the file version of the loaded image
    $stage = 'query Win32_SystemDriver'
    $loaded = @(foreach ($s in Get-CimInstance -ClassName Win32_SystemDriver -Filter "State = 'Running'")
    {{
        $file = Resolve-DriverPath -Path $s.PathName
        $version = ''
        if ($file -and (Test-Path -LiteralPath $file -PathType Leaf))
        {{
            # FileVersion text can carry a build tag, e.g. "10.0.22621.1 (WinBuild.160101.0800)"
            $v = (Get-Item -LiteralPath $file).VersionInfo
            $version = "$($v.FileMajorPart).$($v.FileMinorPart).$($v.FileBuildPart).$($v.FilePrivatePart)"
        }
        [pscustomobject]@{{
            Name        = [string]$s.Name
            DisplayName = [string]$s.DisplayName
            Path        = $file
            FileVersion = $version
            StartMode   = [string]$s.StartMode
        }
    })

    $stage = 'write JSON'
    $result = [pscustomobject]@{{
        SchemaVersion     = 1
        Status            = 'OK'
        CollectedUtc      = Get-UtcStamp
        ComputerName      = $env:COMPUTERNAME
        DeviceCount       = $devices.Count
        LoadedDriverCount = $loaded.Count
        Devices           = $devices
        LoadedDrivers     = $loaded
    }
    $json = ConvertTo-Json -InputObject $result -Depth 4
    [System.IO.File]::WriteAllText($tmpPath, $json, $utf8NoBom)
    Move-Item -LiteralPath $tmpPath -Destination $jsonPath -Force
    Remove-Item -LiteralPath $errorPath -Force -ErrorAction SilentlyContinue
    exit 0
}
catch
{{
    $text = @(
        'Status: Error'
        "TimeUtc: $(Get-UtcStamp)"
        "Stage: $stage"
        "Message: $($_.Exception.Message -replace '\s+', ' ')"
    ) -join "`r`n"
    try
    {{
        Remove-Item -LiteralPath $tmpPath -Force -ErrorAction SilentlyContinue
        if (-not (Test-Path -LiteralPath $OutputFolder)) {{ New-Item -ItemType Directory -Force -Path $OutputFolder | Out-Null }
        [System.IO.File]::WriteAllText($errorPath, "$text`r`n", $utf8NoBom)
    }
    catch
    {{
        # Nowhere to write the report; the Fixlet writes one from the exit code
        Write-Error -Message "Could not write $errorPath : $($_.Exception.Message)" -ErrorAction Continue
    }
    exit 1
}
_END_OF_SCRIPT_
delete "__Download\Get-HardwareDrivers.ps1"
move __createfile "__Download\Get-HardwareDrivers.ps1"

action uses wow64 redirection {not x64 of operating system}
waithidden "{pathname of system folder}\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{pathname of client folder of current site}\__Download\Get-HardwareDrivers.ps1" -OutputFolder "{parameter "probe_folder"}"
parameter "exit_code" = "{exit code of action}"

// PowerShell failed before it could write a report (did not start, was blocked, or could not write the folder)
if {parameter "exit_code" != "0" AND not exists file (parameter "error_file") of folder (parameter "probe_folder")}
	delete __createfile
	createfile until _END_OF_REPORT_
Status: Error
Time: {now}
Stage: run PowerShell
Message: powershell.exe exited with code {parameter "exit_code"} without writing an error report
_END_OF_REPORT_
	copy __createfile "{parameter "probe_folder"}\{parameter "error_file"}"
endif
]]></ActionScript>
		</DefaultAction>
	</Fixlet>
</BES>
