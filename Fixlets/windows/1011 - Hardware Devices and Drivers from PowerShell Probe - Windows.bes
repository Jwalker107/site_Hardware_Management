<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Analysis>
		<Title>Hardware Devices and Drivers from PowerShell Probe - Windows</Title>
		<Description><![CDATA[<P>Reports the results of the Fixlet &quot;Collect Hardware Devices and Drivers to JSON - Windows&quot;, every hour, from &lt;BES Client folder&gt;\PowerShellProbes\HardwareDrivers.json: the hardware devices with their driver provider, version and date, devices Windows reports a problem for, unsigned device drivers, and the kernel drivers that were loaded with their file versions.</P>
<P>When the latest collection failed, <B>Hardware Probe Status</B> is Error and <B>Hardware Probe Error</B> has the report from HardwareDrivers_error.txt. The other properties keep showing the last successful collection; <B>Hardware Probe Collection Time (UTC)</B> says when that was.</P>
<P>The properties re-read the JSON every hour. The data itself is as fresh as the last time the Fixlet ran.</P>]]></Description>
		<Relevance>windows of operating system and (if exists property "in proxy agent context" then not in proxy agent context else true)</Relevance>
		<Relevance><![CDATA[exists folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Relevance>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2026-10-29</SourceReleaseDate>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 29 Oct 2026 18:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<Property Name="Hardware Probe Status" ID="1" EvaluationPeriod="PT1H"><![CDATA[if exists files "HardwareDrivers_error.txt" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe" then "Error" else if exists files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe" then "OK" else "Not Collected"]]></Property>
		<Property Name="Hardware Probe Error" ID="2" EvaluationPeriod="PT1H"><![CDATA[(concatenation " | " of lines of it) of files "HardwareDrivers_error.txt" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
		<Property Name="Hardware Probe Collection Time (UTC)" ID="3" EvaluationPeriod="PT1H"><![CDATA[(value of key "CollectedUtc" of it as string) of jsons of files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
		<Property Name="Hardware Device Count" ID="4" EvaluationPeriod="PT1H"><![CDATA[(value of key "DeviceCount" of it as integer) of jsons of files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
		<Property Name="Hardware Devices and Driver Versions" ID="5" EvaluationPeriod="PT1H"><![CDATA[unique values of ((value of key "Name" of it as string) & " | " & (value of key "Class" of it as string) & " | " & (if (value of key "DriverVersion" of it as string) = "" then "<no driver>" else (value of key "DriverProvider" of it as string) & " | " & (value of key "DriverVersion" of it as string) & (if (value of key "DriverDate" of it as string) = "" then "" else " (" & (value of key "DriverDate" of it as string) & ")"))) of elements of values of keys "Devices" of jsons of files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
		<Property Name="Hardware Devices with Problems" ID="6" EvaluationPeriod="PT1H"><![CDATA[unique values of ((value of key "Name" of it as string) & " | " & (value of key "Class" of it as string) & " | " & (value of key "Status" of it as string) & " | problem code " & (value of key "ProblemCode" of it as integer as string)) of elements whose (value of key "ProblemCode" of it as integer != 0) of values of keys "Devices" of jsons of files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
		<Property Name="Unsigned Device Drivers" ID="7" EvaluationPeriod="PT1H"><![CDATA[unique values of ((value of key "Name" of it as string) & " | " & (value of key "DriverProvider" of it as string) & " | " & (value of key "DriverVersion" of it as string) & " | " & (value of key "DriverInf" of it as string)) of elements whose (value of key "DriverSigned" of it as string = "False") of values of keys "Devices" of jsons of files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
		<Property Name="Loaded Kernel Driver Count" ID="8" EvaluationPeriod="PT1H"><![CDATA[(value of key "LoadedDriverCount" of it as integer) of jsons of files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
		<Property Name="Loaded Kernel Drivers and Versions" ID="9" EvaluationPeriod="PT1H"><![CDATA[unique values of ((value of key "Name" of it as string) & " | " & (value of key "DisplayName" of it as string) & " | " & (if (value of key "FileVersion" of it as string) = "" then "<no version>" else (value of key "FileVersion" of it as string))) of elements of values of keys "LoadedDrivers" of jsons of files "HardwareDrivers.json" of folders "PowerShellProbes" of parent folders of regapps "besclient.exe"]]></Property>
	</Analysis>
</BES>
